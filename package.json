{
  "name": "projurista-mcp",
  "version": "0.2.3",
  "description": "Servidor MCP local do seu cofre do Obsidian, com conexão ao Claude Desktop em um clique.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "claude"
  ],
  "author": "Projurista",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.5",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "^1.6.6",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
